---
import { Image } from 'astro:assets';
import { cannons } from '../data/cannons';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/cannons/*.jpg', {
  eager: true,
});

function imageFor(filename: string) {
  const entry = Object.entries(images).find(([path]) => path.endsWith(filename));
  if (!entry) throw new Error(`Missing cannon image: ${filename}`);
  return entry[1].default;
}
---

<section class="cannon-list" id="cannons">
  <div class="cannon-list__title">
    <h2 class="reveal">The Cannons</h2>
  </div>

  <ol class="cannon-list__rows">
    {
      cannons.map((cannon) => (
        <li class:list={['cannon-row', 'reveal', { 'cannon-row--reverse': cannon.order % 2 === 0 }]}>
          <div class="cannon-row__media">
            <Image
              src={imageFor(cannon.image)}
              alt={cannon.name}
              width={800}
              height={600}
              loading="lazy"
              class="cannon-row__image"
            />
            <span class="cannon-row__number">{cannon.order}</span>
          </div>

          <div class="cannon-row__panel">
            <h3>{cannon.name}</h3>
            <p class="cannon-row__meta">
              <strong>What3words location:</strong>{' '}
              <a
                href={`https://what3words.com/${cannon.what3words.replace(/^\/+/, '')}`}
                target="_blank"
                rel="noopener"
              >
                {cannon.what3words}
              </a>
            </p>
            <p class="cannon-row__meta">
              <strong>Terrain:</strong> {cannon.terrain}
            </p>
            <p class="cannon-row__desc">{cannon.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .cannon-list__title {
    background: #000;
    padding-block: var(--section-padding-y);
    padding-inline: var(--section-padding-x);
  }

  .cannon-list__title h2 {
    color: #fff;
    text-align: center;
    margin: 0;
  }

  .cannon-list__rows {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
  }

  .cannon-row {
    display: flex;
    flex-wrap: wrap;
  }

  .cannon-row--reverse {
    flex-direction: row-reverse;
  }

  .cannon-row__media {
    position: relative;
    flex: 1 1 480px;
    min-width: 320px;
  }

  .cannon-row :global(.cannon-row__image) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1);
  }

  .cannon-row__number {
    position: absolute;
    top: clamp(1rem, 2.5vw, 1.75rem);
    left: clamp(1rem, 2.5vw, 1.75rem);
    width: clamp(64px, 7vw, 92px);
    height: clamp(64px, 7vw, 92px);
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-title);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    box-shadow: 0 0 0 6px var(--color-bg);
  }

  .cannon-row__panel {
    flex: 1 1 480px;
    min-width: 320px;
    background: var(--color-ink);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cannon-row__panel h3 {
    color: #fff;
    text-transform: none;
    letter-spacing: normal;
    font-size: clamp(1.3rem, 1.6vw + 0.9rem, 1.8rem);
    margin-bottom: 1.25rem;
  }

  .cannon-row__meta {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.5rem;
    max-width: none;
  }

  .cannon-row__meta strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .cannon-row__meta a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cannon-row__desc {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 42rem;
  }

  @media (max-width: 700px) {
    .cannon-row,
    .cannon-row--reverse {
      flex-direction: column;
    }

    .cannon-row__panel {
      padding: 2.5rem var(--section-padding-x);
    }
  }
</style>
