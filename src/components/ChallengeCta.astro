---
import { Image } from 'astro:assets';
import cannon1 from '../assets/images/cannon-1.jpg';
import cannon2 from '../assets/images/cannon-2.jpg';
---

<section class="challenge-cta section">
  <div class="container challenge-cta__inner reveal">
    <div class="challenge-cta__images">
      <Image src={cannon1} alt="A historical cannon along the route" width={300} height={180} loading="lazy" />
      <Image src={cannon2} alt="A second historical cannon along the route" width={300} height={180} loading="lazy" />
    </div>
    <a href="/cape-town-cannon-challenge.gpx" download class="btn">Download the Route</a>
  </div>
</section>

<style>
  .challenge-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .challenge-cta__images {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: 2.5rem;
  }

  .challenge-cta__images img {
    width: clamp(140px, 22vw, 220px);
    height: auto;
    object-fit: contain;
  }
</style>
