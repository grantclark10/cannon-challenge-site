---
import { Image } from 'astro:assets';
import type { Charity } from '../data/charities';

import saartjieBaartmanLogo from '../assets/images/saartjie-baartman-centre-logo.png';
import saartjieBaartmanPhoto from '../assets/images/saartjie-baartman-centre-photo.jpg';
import saartjieBaartmanQr from '../assets/images/saartjie-baartman-centre-qr.jpg';
import qhubekaLogo from '../assets/images/qhubeka-logo.png';
import qhubekaPhoto from '../assets/images/qhubeka-photo.jpg';
import qhubekaQr from '../assets/images/qhubeka-qr.jpg';

interface Props {
  charity: Charity;
  reverse?: boolean;
}

const { charity, reverse = false } = Astro.props;

const assets: Record<string, { logo: ImageMetadata; photo: ImageMetadata; qr: ImageMetadata }> = {
  'saartjie-baartman-centre': { logo: saartjieBaartmanLogo, photo: saartjieBaartmanPhoto, qr: saartjieBaartmanQr },
  qhubeka: { logo: qhubekaLogo, photo: qhubekaPhoto, qr: qhubekaQr },
};

const { logo, photo, qr } = assets[charity.slug];
---

<section class:list={['charity-block', 'section', { 'charity-block--reverse': reverse }]}>
  <div class="container charity-block__inner">
    <Image src={photo} alt={charity.name} width={700} height={460} loading="lazy" class="charity-block__photo reveal" />

    <div class="charity-block__copy reveal">
      <Image src={logo} alt={`${charity.name} logo`} width={180} height={90} loading="lazy" class="charity-block__logo" />
      {charity.tagline && <p class="eyebrow">{charity.tagline}</p>}
      <h2>{charity.name}</h2>
      <p>{charity.description}</p>
      <p>Donate by using the button or you can scan the QR code.</p>

      <div class="charity-block__donate">
        <a href={charity.donateUrl} target="_blank" rel="noopener" class="btn">Donate</a>
        <Image src={qr} alt={`QR code to donate to ${charity.name}`} width={120} height={120} loading="lazy" class="charity-block__qr" />
      </div>
    </div>
  </div>
</section>

<style>
  .charity-block__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .charity-block--reverse .charity-block__inner {
    direction: rtl;
  }

  .charity-block--reverse .charity-block__inner > * {
    direction: ltr;
  }

  .charity-block :global(.charity-block__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .charity-block :global(.charity-block__logo) {
    height: 60px;
    width: auto;
    margin-bottom: 1.25rem;
  }

  .charity-block__copy h2 {
    margin-bottom: 1.25rem;
  }

  .charity-block__donate {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .charity-block :global(.charity-block__qr) {
    width: 90px;
    height: 90px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 800px) {
    .charity-block__inner,
    .charity-block--reverse .charity-block__inner {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
