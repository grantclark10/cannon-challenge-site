---
// Contact form — replaces the original Elementor Pro form + reCAPTCHA with
// Formspree, same pattern as the Wild Skies site. Fields match the
// original exactly: name, email, optional Instagram handle, message.
---

<form action="https://formspree.io/f/xkjwpqej" method="POST" id="contact-form" novalidate>
  <div class="contact-form__field">
    <label for="contact-name">Full Name</label>
    <input type="text" name="name" id="contact-name" required autocomplete="name" />
  </div>

  <div class="contact-form__field">
    <label for="contact-email">Email</label>
    <input type="email" name="email" id="contact-email" required autocomplete="email" />
  </div>

  <div class="contact-form__field">
    <label for="contact-instagram">Instagram <span>(optional)</span></label>
    <input type="text" name="instagram" id="contact-instagram" placeholder="@yourhandle" />
  </div>

  <div class="contact-form__field">
    <label for="contact-message">Message</label>
    <textarea name="message" id="contact-message" rows="5" required></textarea>
  </div>

  <input type="hidden" name="_subject" value="New Cannon Challenge enquiry" />
  <input type="hidden" name="_replyto" id="contact-replyto" value="" />

  <div class="contact-form__honeypot" aria-hidden="true">
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" value="" />
  </div>

  <p class="contact-form__error" role="alert" hidden></p>

  <button type="submit" class="btn" id="contact-submit">Submit</button>
</form>

<div class="contact-form__success" role="status" hidden>
  <p>Thanks — we'll be in touch soon.</p>
</div>

<style>
  form {
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-form__field label {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-form__field label span {
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    opacity: 0.6;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-secondary);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form__field textarea {
    resize: vertical;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .contact-form__field input[aria-invalid],
  .contact-form__field textarea[aria-invalid] {
    border-color: var(--color-accent);
  }

  .contact-form__honeypot {
    position: absolute;
    left: -5000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__error {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0;
  }

  button[type='submit'] {
    align-self: flex-start;
  }

  .contact-form__success {
    margin-top: 1.5rem;
    font-family: var(--font-title);
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    button[type='submit'] {
      align-self: stretch;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
  const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;
  const replyToInput = document.getElementById('contact-replyto') as HTMLInputElement | null;
  const errorEl = document.querySelector('.contact-form__error') as HTMLElement | null;
  const successEl = document.querySelector('.contact-form__success') as HTMLElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const name = nameInput?.value.trim() ?? '';
    const email = emailInput?.value.trim() ?? '';
    const message = messageInput?.value.trim() ?? '';

    const isNameValid = name !== '';
    const isEmailValid = EMAIL_PATTERN.test(email);
    const isMessageValid = message !== '';

    nameInput?.toggleAttribute('aria-invalid', !isNameValid);
    emailInput?.toggleAttribute('aria-invalid', !isEmailValid);
    messageInput?.toggleAttribute('aria-invalid', !isMessageValid);

    if (!isNameValid || !isEmailValid || !isMessageValid) {
      if (errorEl) {
        errorEl.textContent = 'Please fill in your name, a valid email, and a message.';
        errorEl.hidden = false;
      }
      (!isNameValid ? nameInput : !isEmailValid ? emailInput : messageInput)?.focus();
      return;
    }

    if (errorEl) errorEl.hidden = true;
    if (replyToInput) replyToInput.value = email;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error('Formspree responded with an error');

      form.hidden = true;
      successEl?.removeAttribute('hidden');
      form.reset();
    } catch {
      if (errorEl) {
        errorEl.textContent = 'Something went wrong. Please try again, or email us directly.';
        errorEl.hidden = false;
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    }
  });
</script>
