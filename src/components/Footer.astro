---
import { Image } from 'astro:assets';
import NewsletterForm from './NewsletterForm.astro';
import routeSquiggle from '../assets/images/route-profile-squiggle.png';
import logo from '../assets/logo/ctcc-logo-black-detailed.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/route/', label: 'The Route' },
  { href: '/challenge/', label: 'The Challenge' },
  { href: '/wall-of-honour/', label: 'Wall of Honour' },
  { href: '/contact/', label: 'Contact' },
];
---

<div class="footer__testimonial-band">
  <div class="container">
    <blockquote class="footer__testimonial">
      <p>
        &ldquo;The route is magic. One of the hardest, but most enjoyable days I&rsquo;ve ever had
        on a bike. This is a tough challenge!&rdquo;
      </p>
      <cite>— Matthew Ross</cite>
    </blockquote>

    <Image
      src={routeSquiggle}
      alt=""
      role="presentation"
      width={986}
      height={165}
      loading="lazy"
      class="footer__squiggle"
    />
  </div>
</div>

<footer class="footer">
  <div class="footer__newsletter section--ink">
    <div class="container">
      <NewsletterForm />
    </div>
  </div>

  <div class="footer__main">
    <div class="container footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Cape Town Cannon Challenge" width={280} height={157} loading="lazy" class="footer__logo" />
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <h4>Explore</h4>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>

        <ul class="footer__socials">
          <li>
            <a href="https://www.instagram.com/capetowncannonchallenge/" target="_blank" rel="noopener">
              <span class="visually-hidden">Instagram (opens in new tab)</span>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06zM12 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.162 6.162 6.162 6.162-2.759 6.162-6.162S15.403 5.838 12 5.838zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44 1.44-.644 1.44-1.44-.644-1.44-1.44-1.44z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/capetowncannonchallenge" target="_blank" rel="noopener">
              <span class="visually-hidden">Facebook (opens in new tab)</span>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.653-.017c-.9 0-1.599.204-2.049.752-.35.428-.53 1.025-.53 1.955v1.581h3.492l-.615 3.667h-2.877v7.98H9.101z"/></svg>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        &copy; Copyright {new Date().getFullYear()} Cape Town Cannon Challenge. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }

  .footer__newsletter {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .footer__main {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem 3rem;
  }

  .footer :global(.footer__logo) {
    width: clamp(200px, 20vw, 280px);
    height: auto;
  }

  .footer__nav h4 {
    margin-bottom: 1rem;
  }

  .footer__nav ul:not(.footer__socials) {
    list-style: none;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: 2rem;
    row-gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .footer__nav a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0.75;
    white-space: nowrap;
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer__socials {
    list-style: none;
    display: flex;
    justify-content: flex-start;
    gap: 1.5rem;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
  }

  .footer__socials a {
    display: flex;
    padding: 10px;
    margin: -10px;
    color: var(--color-text);
  }

  .footer__socials a:hover,
  .footer__socials a:focus-visible {
    color: var(--color-accent);
  }

  .footer__testimonial-band :global(.footer__squiggle) {
    max-width: 420px;
    width: 100%;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    opacity: 0.5;
  }

  .footer__testimonial-band {
    background: var(--color-bg);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer__testimonial {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0;
    border: none;
    text-align: center;
  }

  .footer__testimonial p {
    font-family: 'Fira Sans', var(--font-title);
    font-size: clamp(1.1rem, 1.5vw + 0.9rem, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .footer__testimonial cite {
    font-style: normal;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .footer__bottom {
    padding-block: 1.5rem;
  }

  .footer__copyright {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin: 0;
    max-width: none;
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer__grid {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .footer__brand {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer :global(.footer__logo) {
      margin-inline: auto;
    }

    .footer__nav {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer__nav ul {
      justify-content: center;
    }

    .footer__socials {
      justify-content: center;
      margin-top: clamp(3rem, 6vw, 4rem);
    }
  }
</style>
