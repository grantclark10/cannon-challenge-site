---
import { Image } from 'astro:assets';
import NewsletterForm from './NewsletterForm.astro';
import routeSquiggle from '../assets/images/route-profile-squiggle.png';
import logo from '../assets/logo/ctcc-logo-black-detailed.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/route/', label: 'The Route' },
  { href: '/challenge/', label: 'The Challenge' },
  { href: '/wall-of-honour/', label: 'Wall of Honour' },
  { href: '/contact/', label: 'Contact' },
];

const socials = [
  { href: 'https://www.instagram.com/capetowncannonchallenge/', label: 'Instagram' },
  { href: 'https://www.facebook.com/capetowncannonchallenge', label: 'Facebook' },
];
---

<footer class="footer">
  <div class="footer__newsletter section--ink">
    <div class="container">
      <NewsletterForm />
    </div>
  </div>

  <div class="footer__main">
    <div class="container footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Cape Town Cannon Challenge" width={280} height={157} loading="lazy" class="footer__logo" />
        <ul class="footer__socials">
          {
            socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <h4>Explore</h4>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <blockquote class="footer__testimonial">
        <p>
          &ldquo;The route is magic. One of the hardest, but most enjoyable days I&rsquo;ve ever
          had on a bike. This is a tough challenge!&rdquo;
        </p>
        <cite>— Matthew Ross</cite>
      </blockquote>
    </div>

    <Image
      src={routeSquiggle}
      alt=""
      role="presentation"
      width={986}
      height={165}
      loading="lazy"
      class="footer__squiggle"
    />
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        &copy; Copyright {new Date().getFullYear()} Cape Town Cannon Challenge. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }

  .footer__newsletter {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .footer__main {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer :global(.footer__logo) {
    width: clamp(200px, 20vw, 280px);
    height: auto;
    margin-bottom: 1.75rem;
  }

  .footer__socials {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .footer__socials a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .footer__socials a:hover,
  .footer__socials a:focus-visible {
    color: var(--color-accent);
  }

  .footer__nav h4 {
    margin-bottom: 1.5rem;
  }

  .footer__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .footer__nav a {
    font-size: 0.95rem;
    color: var(--color-text);
    opacity: 0.75;
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer__testimonial {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-bg);
    border-left: 3px solid var(--color-accent);
  }

  .footer__testimonial p {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .footer__testimonial cite {
    font-style: normal;
    font-size: 0.8rem;
    color: var(--color-secondary);
  }

  .footer :global(.footer__squiggle) {
    max-width: 420px;
    width: 100%;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    opacity: 0.5;
  }

  .footer__bottom {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-block: 1.5rem;
  }

  .footer__copyright {
    font-size: 0.78rem;
    color: var(--color-secondary);
    margin: 0;
    max-width: none;
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__testimonial {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer__brand {
      align-items: center;
    }

    .footer :global(.footer__logo) {
      margin-inline: auto;
    }

    .footer__nav ul {
      align-items: center;
    }
  }
</style>
