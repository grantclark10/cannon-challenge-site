---
import { Image } from 'astro:assets';
import NewsletterForm from './NewsletterForm.astro';
import routeSquiggle from '../assets/images/route-profile-squiggle.png';
import logo from '../assets/logo/ctcc-logo-black-detailed.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/route/', label: 'The Route' },
  { href: '/challenge/', label: 'The Challenge' },
  { href: '/wall-of-honour/', label: 'Wall of Honour' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="footer">
  <div class="footer__newsletter section--ink">
    <div class="container">
      <NewsletterForm />
    </div>
  </div>

  <div class="footer__main">
    <div class="container footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Cape Town Cannon Challenge" width={280} height={157} loading="lazy" class="footer__logo" />
        <ul class="footer__socials">
          <li>
            <a href="https://www.instagram.com/capetowncannonchallenge/" target="_blank" rel="noopener">
              <span class="visually-hidden">Instagram</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.8.07 1.2.06 2.1.26 2.8.55.8.3 1.4.7 2 1.3.6.6 1 1.2 1.3 2 .3.7.5 1.6.55 2.8.06 1.2.07 1.6.07 4.8s0 3.6-.07 4.8c-.06 1.2-.26 2.1-.55 2.8-.3.8-.7 1.4-1.3 2-.6.6-1.2 1-2 1.3-.7.3-1.6.5-2.8.55-1.2.06-1.6.07-4.8.07s-3.6 0-4.8-.07c-1.2-.06-2.1-.26-2.8-.55-.8-.3-1.4-.7-2-1.3-.6-.6-1-1.2-1.3-2-.3-.7-.5-1.6-.55-2.8C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.8c.06-1.2.26-2.1.55-2.8.3-.8.7-1.4 1.3-2 .6-.6 1.2-1 2-1.3.7-.3 1.6-.5 2.8-.55C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5 0-4.74.07-1 .05-1.6.2-1.97.35-.5.19-.85.42-1.22.79-.37.37-.6.72-.79 1.22-.14.37-.3.96-.35 1.97C3.8 8.5 3.8 8.86 3.8 12s0 3.5.13 4.6c.05 1 .2 1.6.35 1.97.19.5.42.85.79 1.22.37.37.72.6 1.22.79.37.14.96.3 1.97.35 1.24.06 1.6.07 4.74.07s3.5 0 4.74-.07c1-.05 1.6-.2 1.97-.35.5-.19.85-.42 1.22-.79.37-.37.6-.72.79-1.22.14-.37.3-.96.35-1.97.06-1.1.07-1.46.07-4.6s0-3.5-.07-4.6c-.05-1-.2-1.6-.35-1.97a3.3 3.3 0 0 0-.79-1.22 3.3 3.3 0 0 0-1.22-.79c-.37-.14-.96-.3-1.97-.35C15.5 4 15.14 4 12 4zm0 3.9a4.1 4.1 0 1 1 0 8.2 4.1 4.1 0 0 1 0-8.2zm0 1.8a2.3 2.3 0 1 0 0 4.6 2.3 2.3 0 0 0 0-4.6zm5.2-2a.96.96 0 1 1-1.92 0 .96.96 0 0 1 1.92 0z"/></svg>
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/capetowncannonchallenge" target="_blank" rel="noopener">
              <span class="visually-hidden">Facebook</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.7h2.6l.4-3H13.5V8.3c0-.87.24-1.46 1.5-1.46h1.6V4.14C16.3 4.1 15.3 4 14.2 4c-2.5 0-4.2 1.5-4.2 4.3v2h-2.6v3h2.6V21h3.5z"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <h4>Explore</h4>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <Image
      src={routeSquiggle}
      alt=""
      role="presentation"
      width={986}
      height={165}
      loading="lazy"
      class="footer__squiggle"
    />
  </div>

  <div class="footer__testimonial-band">
    <div class="container">
      <blockquote class="footer__testimonial">
        <p>
          &ldquo;The route is magic. One of the hardest, but most enjoyable days I&rsquo;ve ever
          had on a bike. This is a tough challenge!&rdquo;
        </p>
        <cite>— Matthew Ross</cite>
      </blockquote>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        &copy; Copyright {new Date().getFullYear()} Cape Town Cannon Challenge. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }

  .footer__newsletter {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .footer__main {
    padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer :global(.footer__logo) {
    width: clamp(200px, 20vw, 280px);
    height: auto;
    margin-bottom: 1.75rem;
  }

  .footer__socials {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .footer__socials a {
    display: flex;
    color: var(--color-text);
  }

  .footer__socials a:hover,
  .footer__socials a:focus-visible {
    color: var(--color-accent);
  }

  .footer__nav h4 {
    margin-bottom: 1.5rem;
  }

  .footer__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }

  .footer__nav a {
    font-size: 0.95rem;
    color: var(--color-text);
    opacity: 0.75;
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer :global(.footer__squiggle) {
    max-width: 420px;
    width: 100%;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    opacity: 0.5;
  }

  .footer__testimonial-band {
    background: var(--color-bg);
    border-block: 1px solid rgba(0, 0, 0, 0.08);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .footer__testimonial {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0;
    border: none;
    text-align: center;
  }

  .footer__testimonial p {
    font-family: var(--font-title);
    font-size: clamp(1.1rem, 1.5vw + 0.9rem, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .footer__testimonial cite {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .footer__bottom {
    padding-block: 1.5rem;
  }

  .footer__copyright {
    font-size: 0.78rem;
    color: var(--color-secondary);
    margin: 0;
    max-width: none;
    text-align: center;
  }

  @media (max-width: 600px) {
    .footer__grid {
      justify-content: center;
      text-align: center;
    }

    .footer__brand {
      align-items: center;
    }

    .footer :global(.footer__logo) {
      margin-inline: auto;
    }

    .footer__socials {
      justify-content: center;
    }

    .footer__nav ul {
      align-items: center;
    }
  }
</style>
