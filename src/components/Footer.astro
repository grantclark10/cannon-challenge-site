---
import { Image } from 'astro:assets';
import NewsletterForm from './NewsletterForm.astro';
import routeSquiggle from '../assets/images/route-profile-squiggle.png';
import logo from '../assets/logo/ctcc-logo-white.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/route/', label: 'The Route' },
  { href: '/challenge/', label: 'The Challenge' },
  { href: '/wall-of-honour/', label: 'Wall of Honour' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="footer">
  <div class="footer__newsletter section--ink">
    <div class="container">
      <Image src={logo} alt="Cape Town Cannon Challenge" width={220} height={116} loading="lazy" class="footer__logo" />
      <NewsletterForm />
    </div>
  </div>

  <div class="footer__follow">
    <div class="container">
      <h4>Follow the Cannon Challenge</h4>
      <ul class="footer__socials">
        <li>
          <a href="https://www.instagram.com/capetowncannonchallenge/" target="_blank" rel="noopener">
            Instagram
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/capetowncannonchallenge" target="_blank" rel="noopener">
            Facebook
          </a>
        </li>
      </ul>

      <blockquote class="footer__testimonial">
        <p>
          &ldquo;The route is magic. One of the hardest, but most enjoyable days I&rsquo;ve ever
          had on a bike. This is a tough challenge!&rdquo;
        </p>
        <cite>— Matthew Ross</cite>
      </blockquote>

      <Image
        src={routeSquiggle}
        alt=""
        role="presentation"
        width={986}
        height={165}
        loading="lazy"
        class="footer__squiggle"
      />
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <nav aria-label="Footer navigation">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="footer__copyright">
        &copy; Copyright {new Date().getFullYear()} Cape Town Cannon Challenge. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
  }

  .footer__newsletter {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .footer :global(.footer__logo) {
    width: clamp(120px, 14vw, 170px);
    height: auto;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .footer__follow {
    padding-block: clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .footer__follow h4 {
    margin-bottom: 1.25rem;
  }

  .footer__socials {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin: 0 0 2.5rem;
    padding: 0;
  }

  .footer__socials a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .footer__socials a:hover,
  .footer__socials a:focus-visible {
    color: var(--color-accent);
  }

  .footer__testimonial {
    max-width: 42rem;
    margin: 0 auto 2.5rem;
    padding: 0;
    border: none;
  }

  .footer__testimonial p {
    font-family: var(--font-title);
    font-size: clamp(1.1rem, 1.5vw + 0.9rem, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.75rem;
    max-width: none;
  }

  .footer__testimonial cite {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .footer :global(.footer__squiggle) {
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
    opacity: 0.6;
  }

  .footer__bottom {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-block: 1.75rem;
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__bottom-inner nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .footer__bottom-inner nav a {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    opacity: 0.75;
  }

  .footer__bottom-inner nav a:hover,
  .footer__bottom-inner nav a:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer__copyright {
    font-size: 0.78rem;
    color: var(--color-secondary);
    margin: 0;
    max-width: none;
  }
</style>
