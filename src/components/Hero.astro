---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-cycle-race.jpg';
---

<section class="hero" id="top">
  <Image
    src={heroImage}
    alt="Cyclists riding the Cape Town Cannon Challenge route"
    width={1920}
    height={1280}
    loading="eager"
    fetchpriority="high"
    class="hero__image"
  />
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1>Ride or run all of the historical cannons around Cape Town. <span class="hero__boom">Boom!</span></h1>
    <p class="hero__lede">
      The Cape Town Cannon Challenge is a mixed terrain route which links many of the historical
      cannons dotted around the Cape peninsula.
    </p>
    <p class="hero__stats">16 cannons &ndash; 160km &ndash; 2750m elevation</p>
    <div class="hero__ctas">
      <a href="/route/" class="btn">See the Route</a>
      <a href="/challenge/" class="btn btn--outline-light">The Challenge</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.75) 100%);
  }

  .hero__content {
    position: relative;
    padding-block: clamp(3rem, 8vw, 5rem);
    max-width: 60rem;
  }

  .hero__boom {
    color: var(--color-accent);
  }

  .hero__lede {
    font-size: clamp(1.05rem, 1.2vw + 0.9rem, 1.35rem);
    max-width: 42ch;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__stats {
    font-family: var(--font-title);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: clamp(1rem, 1vw + 0.85rem, 1.2rem);
    color: var(--color-accent);
    max-width: none;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
