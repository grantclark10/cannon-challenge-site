---
import { Image } from 'astro:assets';
import cannon1 from '../assets/images/cannon-1.jpg';
import cannon2 from '../assets/images/cannon-2.jpg';
---

<section class="home-intro section">
  <div class="container home-intro__inner">
    <div class="home-intro__images reveal">
      <Image src={cannon1} alt="One of the historical cannons on the Cape Town Cannon Challenge route" width={300} height={180} loading="lazy" />
      <Image src={cannon2} alt="A second historical cannon along the route" width={300} height={180} loading="lazy" />
    </div>

    <div class="home-intro__copy reveal">
      <h2>Challenge yourself to ride (or run!) this magical mixed terrain route.</h2>
      <p>
        Do it in one day or over multi days. Do it solo or take the family. Do it in a relay team.
        Do it as a challenge to raise money for charity. It's the adventure and story that counts!
      </p>
      <p>
        Complete the challenge, submit your time and win some amazing prizes and gear from East
        City Cycles and Jack Black Beer! Don't forget to tag @ctcannonchallenge on Instagram and
        we'll feature your story!
      </p>
      <a href="/cape-town-cannon-challenge.gpx" download class="btn">Download the Route</a>
      <a href="/route/" class="home-intro__learn-more">Learn More</a>
    </div>
  </div>
</section>

<style>
  .home-intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .home-intro__images {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: 2.5rem;
  }

  .home-intro__images img {
    width: clamp(140px, 22vw, 220px);
    height: auto;
    object-fit: contain;
  }

  .home-intro__copy {
    max-width: 60rem;
  }

  .home-intro__copy h2 {
    margin-bottom: 1.5rem;
  }

  .home-intro__copy p {
    max-width: 42rem;
    margin-inline: auto;
  }

  .home-intro__copy .btn {
    margin-top: 1rem;
  }

  .home-intro__learn-more {
    display: block;
    margin-top: 1.25rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-intro__learn-more:hover,
  .home-intro__learn-more:focus-visible {
    color: var(--color-accent);
  }
</style>
