---
import { Image } from 'astro:assets';
import cannon1 from '../assets/images/cannon-1.jpg';
import cannon2 from '../assets/images/cannon-2.jpg';
---

<section class="home-intro section">
  <div class="container home-intro__inner">
    <div class="home-intro__images reveal">
      <Image src={cannon1} alt="One of the historical cannons on the Cape Town Cannon Challenge route" width={500} height={620} loading="lazy" />
      <Image src={cannon2} alt="A second historical cannon along the route" width={500} height={620} loading="lazy" />
    </div>

    <div class="home-intro__copy reveal">
      <h2>Challenge yourself to ride (or run!) this magical mixed terrain route.</h2>
      <p>
        Do it in one day or over multi days. Do it solo or take the family. Do it in a relay team.
        Do it as a challenge to raise money for charity. It's the adventure and story that counts!
      </p>
      <p>
        Complete the challenge, submit your time and win some amazing prizes and gear from East
        City Cycles and Jack Black Beer! Don't forget to tag @ctcannonchallenge on Instagram and
        we'll feature your story!
      </p>
      <a href="/route/" class="btn btn--outline">Download the Route</a>
    </div>
  </div>
</section>

<style>
  .home-intro__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .home-intro__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .home-intro__images img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .home-intro__images :global(img):first-child {
    margin-top: 2.5rem;
  }

  .home-intro__copy h2 {
    margin-bottom: 1.5rem;
  }

  .home-intro__copy .btn {
    margin-top: 0.5rem;
  }

  @media (max-width: 800px) {
    .home-intro__inner {
      grid-template-columns: 1fr;
    }

    .home-intro__images :global(img):first-child {
      margin-top: 0;
    }
  }
</style>
