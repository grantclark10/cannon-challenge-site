---
// Sticky header nav — real routes (this is a multi-page site, unlike a
// single-page scroller), so links are actual hrefs, not same-page anchors.
import { Image } from 'astro:assets';
import logo from '../assets/logo/ctcc-logo-white.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/route/', label: 'The Route' },
  { href: '/challenge/', label: 'The Challenge' },
  { href: '/wall-of-honour/', label: 'Wall of Honour' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__brand" aria-label="Cape Town Cannon Challenge home">
      <Image src={logo} alt="Cape Town Cannon Challenge logo" width={220} height={116} loading="eager" />
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      id="nav-toggle"
    >
      <span class="visually-hidden">Toggle menu</span>
      <span class="nav__toggle-bar" aria-hidden="true"></span>
    </button>

    <nav aria-label="Primary navigation" id="nav-links" class="nav__links">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.94);
    color: #fff;
    height: var(--nav-height);
    display: flex;
    align-items: center;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .nav__brand img {
    height: 52px;
    width: auto;
  }

  .nav__toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: #fff;
  }

  .nav__toggle-bar,
  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    display: block;
    width: 26px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform 0.2s ease, background-color 0.2s ease, top 0.2s ease;
  }

  .nav__toggle-bar::before,
  .nav__toggle-bar::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav__toggle-bar::before {
    top: -8px;
  }

  .nav__toggle-bar::after {
    top: 8px;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-bar {
    background: transparent;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-bar::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-bar::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__links ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .nav__links a:hover,
  .nav__links a:focus-visible,
  .nav__links a[aria-current='page'] {
    opacity: 1;
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .nav__toggle {
      display: inline-flex;
    }

    .nav__links {
      position: fixed;
      inset: var(--nav-height) 0 0 0;
      background: #000;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding: 2rem var(--section-padding-x);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
    }

    .nav__links.is-open {
      transform: translateX(0);
    }

    .nav__links ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      width: 100%;
    }

    .nav__links a {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  links?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
