---
// Sitewide "Sign Up" newsletter block — same copy as the original footer.
// Posts to Formspree, same pattern as ContactForm.astro and
// UploadChallengeModal.astro.
---

<div class="newsletter">
  <h2>Sign Up</h2>
  <p class="lede newsletter__lede">
    We're going to be launching the one day event and relay soon as well as announcing special
    prizes and new partnerships, so drop in your name and email and we'll keep you informed.
  </p>

  <form action="https://formspree.io/f/mwlewrjl" method="POST" id="newsletter-form" class="newsletter__form" novalidate>
    <div class="newsletter__field-row">
      <label for="newsletter-name" class="visually-hidden">Name</label>
      <input type="text" name="name" id="newsletter-name" placeholder="Name" required autocomplete="name" />

      <label for="newsletter-email" class="visually-hidden">Email address</label>
      <input type="email" name="email" id="newsletter-email" placeholder="Email" required autocomplete="email" />

      <button type="submit" class="btn newsletter__submit" id="newsletter-submit">Sign Up</button>
    </div>

    <input type="hidden" name="_subject" value="New Cannon Challenge newsletter sign-up" />

    <div class="newsletter__honeypot" aria-hidden="true">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" value="" />
    </div>

    <p class="newsletter__error" role="alert" hidden>Please enter your name and a valid email.</p>
  </form>

  <div class="newsletter__success" role="status" hidden>
    <p>You're in. We'll keep you posted.</p>
  </div>
</div>

<style>
  .newsletter {
    text-align: center;
  }

  .newsletter h2 {
    margin-bottom: 1rem;
  }

  .newsletter__lede {
    max-width: 42rem;
    margin-inline: auto;
    color: rgba(255, 255, 255, 0.8);
  }

  .newsletter__form {
    max-width: 40rem;
    margin-inline: auto;
    margin-top: 1.75rem;
  }

  .newsletter__field-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .newsletter__field-row input {
    flex: 1 1 200px;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: #fff;
    color: var(--color-text);
  }

  .newsletter__field-row input:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .newsletter__submit {
    flex-shrink: 0;
  }

  .newsletter__honeypot {
    position: absolute;
    left: -5000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter__error {
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .newsletter__success {
    margin-top: 1.5rem;
    font-family: var(--font-title);
    font-size: 1.1rem;
  }
</style>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('newsletter-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
  const errorEl = form?.querySelector('.newsletter__error') as HTMLElement | null;
  const successEl = document.querySelector('.newsletter__success') as HTMLElement | null;
  const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const name = nameInput?.value.trim() ?? '';
    const email = emailInput?.value.trim() ?? '';
    const isValid = name !== '' && EMAIL_PATTERN.test(email);

    nameInput?.toggleAttribute('aria-invalid', name === '');
    emailInput?.toggleAttribute('aria-invalid', !EMAIL_PATTERN.test(email));

    if (!isValid) {
      errorEl?.removeAttribute('hidden');
      (name === '' ? nameInput : emailInput)?.focus();
      return;
    }

    errorEl?.setAttribute('hidden', '');

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing up…';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error('Formspree responded with an error');

      form.hidden = true;
      successEl?.removeAttribute('hidden');
      form.reset();
    } catch {
      if (errorEl) {
        errorEl.textContent = 'Something went wrong. Please try again, or email us directly.';
        errorEl.hidden = false;
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign Up';
      }
    }
  });
</script>
