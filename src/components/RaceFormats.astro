---
import { Image } from 'astro:assets';
import challengeImage from '../assets/images/challenge-hero.jpg';
import cyclistsImage from '../assets/images/cyclists-cape-town.jpg';
import wallOfHonourImage from '../assets/images/wall-of-honour-hero.jpg';

const formats = [
  {
    name: 'Cannon Challenge',
    image: challengeImage,
    alt: 'Cyclist on the Cape Town Cannon Challenge route',
    cta: { label: 'Learn more', href: '/route/' },
  },
  {
    name: 'Cannon Challenge One Day Event',
    image: cyclistsImage,
    alt: 'Cyclists riding through Cape Town',
    cta: { label: 'Coming soon', href: null },
  },
  {
    name: 'Cannon Challenge 100 Miler',
    image: wallOfHonourImage,
    alt: 'Cyclists on the Cape Town Cannon Challenge route',
    cta: { label: 'Coming soon', href: null },
  },
];
---

<section class="race-formats">
  <div class="race-formats__grid">
    {
      formats.map((format) => (
        <div class="race-formats__card reveal">
          <Image src={format.image} alt={format.alt} width={700} height={900} loading="lazy" class="race-formats__image" />
          <div class="race-formats__overlay" aria-hidden="true" />
          <div class="race-formats__body">
            <h2>{format.name}</h2>
            {format.cta.href ? (
              <a href={format.cta.href} class="btn btn--outline-light">
                {format.cta.label}
              </a>
            ) : (
              <span class="race-formats__coming-soon">{format.cta.label}</span>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .race-formats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .race-formats__card {
    position: relative;
    min-height: clamp(320px, 40vw, 420px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .race-formats__card :global(.race-formats__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .race-formats__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.85) 100%);
  }

  .race-formats__body {
    position: relative;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .race-formats__body h2 {
    color: #fff;
    font-size: clamp(1.3rem, 2vw + 0.8rem, 1.9rem);
  }

  .race-formats__coming-soon {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 800px) {
    .race-formats__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
