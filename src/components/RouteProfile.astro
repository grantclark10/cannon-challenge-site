---
import { Image } from 'astro:assets';
import profileImage from '../assets/images/route-elevation-profile.jpg';
---

<section class="route-profile section section--surface">
  <div class="container">
    <h2 class="reveal">The Profile</h2>
    <Image
      src={profileImage}
      alt="Elevation profile of the Cape Town Cannon Challenge route, showing 2750m of climbing over 160km"
      width={1600}
      height={500}
      loading="lazy"
      class="route-profile__image reveal"
    />
  </div>
</section>

<style>
  .route-profile h2 {
    margin-bottom: 2rem;
  }

  .route-profile :global(.route-profile__image) {
    width: 100%;
    height: auto;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
</style>
