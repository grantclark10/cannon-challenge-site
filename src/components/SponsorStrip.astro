---
// "Proudly partnering with" — appears near the bottom of every page, just
// above the footer, same as the original site.
import { Image } from 'astro:assets';
import { sponsors } from '../data/sponsors';

import eastCityCyclesLogo from '../assets/images/east-city-cycles-logo.png';
import jackBlackBrewingLogo from '../assets/images/jack-black-brewing-logo.png';

const logos: Record<string, ImageMetadata> = {
  'east-city-cycles-logo.png': eastCityCyclesLogo,
  'jack-black-brewing-logo.png': jackBlackBrewingLogo,
};
---

<section class="sponsor-strip">
  <div class="container sponsor-strip__inner">
    <h3>Proudly partnering with</h3>
    <ul class="sponsor-strip__logos">
      {
        sponsors.map((sponsor) => (
          <li>
            <Image src={logos[sponsor.logo]} alt={sponsor.name} width={202} height={100} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sponsor-strip {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .sponsor-strip__inner {
    text-align: center;
  }

  .sponsor-strip h3 {
    color: var(--color-secondary);
    margin-bottom: 1.5rem;
  }

  .sponsor-strip__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
  }

  .sponsor-strip__logos img {
    max-height: 60px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .sponsor-strip__logos img:hover {
    filter: grayscale(0);
    opacity: 1;
  }
</style>
