---
// "Proudly partnering with" — appears near the bottom of every page, just
// above the footer, same as the original site. Red band with a topographic
// contour-line texture blended over it, matching the original brand.
import { Image, getImage } from 'astro:assets';
import { sponsors } from '../data/sponsors';

import eastCityCyclesLogo from '../assets/images/east-city-cycles-logo.png';
import jackBlackBrewingLogo from '../assets/images/jack-black-brewing-logo.png';
import contourTexture from '../assets/images/contour-texture.png';

const logos: Record<string, ImageMetadata> = {
  'east-city-cycles-logo.png': eastCityCyclesLogo,
  'jack-black-brewing-logo.png': jackBlackBrewingLogo,
};

const contourImage = await getImage({ src: contourTexture, width: 1600, format: 'webp' });
---

<section class="sponsor-strip" style={`background-image: url(${contourImage.src})`}>
  <div class="container sponsor-strip__inner">
    <h3>Proudly partnering with</h3>
    <ul class="sponsor-strip__logos">
      {
        sponsors.map((sponsor) => (
          <li>
            <Image src={logos[sponsor.logo]} alt={sponsor.name} width={202} height={100} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sponsor-strip {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background-color: var(--color-accent);
    background-repeat: repeat;
    background-size: 700px auto;
    background-blend-mode: soft-light;
  }

  .sponsor-strip__inner {
    text-align: center;
  }

  .sponsor-strip h3 {
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .sponsor-strip__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
  }

  .sponsor-strip__logos img {
    max-height: 60px;
    width: auto;
  }
</style>
