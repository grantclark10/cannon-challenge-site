---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ContactForm from '../../components/ContactForm.astro';
import SponsorStrip from '../../components/SponsorStrip.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/contact-hero.jpg';
import logo from '../../assets/logo/ctcc-logo-white.png';
---

<Layout
  title="Contact — Cape Town Cannon Challenge"
  description="Contact the Cape Town Cannon Challenge. Contact details for the Cape Town Cannon Challenge."
>
  <Nav />
  <main id="main">
    <section class="contact-hero">
      <Image
        src={heroImage}
        alt="A historical cannon along the Cape Town Cannon Challenge route"
        width={1920}
        height={1280}
        loading="eager"
        fetchpriority="high"
        class="contact-hero__image"
      />
      <div class="contact-hero__overlay" aria-hidden="true"></div>

      <div class="container contact-hero__content">
        <Image src={logo} alt="Cape Town Cannon Challenge" width={220} height={116} loading="eager" class="contact-hero__logo" />
        <h1>Contact Us</h1>
      </div>
    </section>

    <section class="contact section">
      <div class="container contact__inner reveal">
        <h2>Say Hello</h2>
        <p class="lede">
          We'd love to hear your story, or feedback about the route, or anything really! OK not
          anything. But let us know how you did, if you did it for a charity or a personal
          challenge or as a relay. Or ask us a question about the route!
        </p>
        <p class="contact__email">
          <a href="mailto:hello@cannonchallenge.capetown">hello@cannonchallenge.capetown</a>
        </p>

        <ContactForm />
      </div>
    </section>

    <SponsorStrip />
  </main>
  <Footer />
</Layout>

<style>
  .contact-hero {
    position: relative;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    padding-block: clamp(3.5rem, 10vw, 6rem);
  }

  .contact-hero :global(.contact-hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.75) 100%);
  }

  .contact-hero__content {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-hero :global(.contact-hero__logo) {
    width: clamp(140px, 16vw, 200px);
    height: auto;
    margin-bottom: 1.75rem;
  }

  .contact {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .contact__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .contact__inner .lede {
    margin-inline: auto;
    margin-top: 1rem;
  }

  .contact__email {
    margin-top: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .contact__email a {
    font-weight: 700;
  }

  .contact__inner :global(form) {
    margin-inline: auto;
    text-align: left;
  }
</style>
