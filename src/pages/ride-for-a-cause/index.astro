---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import CharityBlock from '../../components/CharityBlock.astro';
import SponsorStrip from '../../components/SponsorStrip.astro';
import Footer from '../../components/Footer.astro';
import { charities } from '../../data/charities';
---

<Layout
  title="Ride for a Cause — Cape Town Cannon Challenge"
  description="The Cape Town Cannon Challenge primarily exists to raise awareness for two incredible organisations - The Saartjie Baartman Centre for Women and Children and Qhubeka."
>
  <Nav />
  <main id="main">
    <section class="cause-intro section">
      <div class="container cause-intro__inner reveal">
        <h1>Ride for a Cause</h1>
        <h2>Be Kind, Do Good</h2>
        <p class="lede">
          You can ride for your own charity, but the Cannon Challenge primarily exists to raise
          awareness for two incredible organisations. If you take on the challenge, please think
          about donating or giving a shoutout to these two amazing projects!
        </p>
      </div>
    </section>

    {charities.map((charity, i) => <CharityBlock charity={charity} reverse={i % 2 === 1} />)}

    <SponsorStrip />
  </main>
  <Footer />
</Layout>

<style>
  .cause-intro__inner {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .cause-intro__inner h2 {
    color: var(--color-accent);
    margin-top: 0.5rem;
  }

  .cause-intro__inner .lede {
    margin-inline: auto;
    margin-top: 1.5rem;
  }
</style>
