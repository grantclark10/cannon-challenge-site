---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import UploadChallengeModal from '../../components/UploadChallengeModal.astro';
import LeaderboardTable from '../../components/LeaderboardTable.astro';
import SponsorStrip from '../../components/SponsorStrip.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Wall of Honour — Cape Town Cannon Challenge"
  description="Upload your result and join the Wall of Honour. We'll feature you on our social media as well!"
>
  <Nav />
  <main id="main">
    <section class="wall-intro section">
      <div class="container wall-intro__inner reveal">
        <h1>Wall of Honour</h1>
        <h2>Boom!</h2>
        <p class="lede">
          Upload your result and join the wall of honour. We'll feature you on our social media as
          well!
        </p>
        <UploadChallengeModal />
      </div>
    </section>

    <LeaderboardTable />
    <SponsorStrip />
  </main>
  <Footer />
</Layout>

<style>
  .wall-intro__inner {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }

  .wall-intro__inner h2 {
    color: var(--color-accent);
    margin-top: 0.5rem;
  }

  .wall-intro__inner .lede {
    margin-inline: auto;
    margin-block: 1.5rem 2rem;
  }
</style>
