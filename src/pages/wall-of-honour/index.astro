---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import UploadChallengeModal from '../../components/UploadChallengeModal.astro';
import LeaderboardTable from '../../components/LeaderboardTable.astro';
import SponsorStrip from '../../components/SponsorStrip.astro';
import Footer from '../../components/Footer.astro';
import heroImage from '../../assets/images/wall-of-honour-hero.jpg';
---

<Layout
  title="Wall of Honour — Cape Town Cannon Challenge"
  description="See every rider and runner who has completed the Cape Town Cannon Challenge, with their finish time and Strava link. Upload your own result to join them."
>
  <Nav />
  <main id="main">
    <section class="wall-hero">
      <Image
        src={heroImage}
        alt="Cyclists on the Cape Town Cannon Challenge route"
        width={1920}
        height={1280}
        loading="eager"
        fetchpriority="high"
        class="wall-hero__image"
      />
      <div class="wall-hero__overlay" aria-hidden="true"></div>

      <div class="container wall-hero__content">
        <h1>Wall of Honour</h1>
      </div>
    </section>

    <section class="wall-copy section">
      <div class="container wall-copy__inner reveal">
        <p class="lede">
          Upload your result and join the wall of honour. We'll feature you on our social media as
          well!
        </p>
        <UploadChallengeModal />
      </div>
    </section>

    <LeaderboardTable />
    <SponsorStrip />
  </main>
  <Footer />
</Layout>

<style>
  .wall-hero {
    position: relative;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
    padding-block: clamp(3.5rem, 10vw, 6rem);
  }

  .wall-hero :global(.wall-hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wall-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.85) 100%);
  }

  .wall-hero__content {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wall-copy {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .wall-copy__inner {
    max-width: 50rem;
    margin-inline: auto;
    text-align: center;
  }

  .wall-copy__inner .lede {
    margin-inline: auto;
    margin-bottom: 2rem;
  }
</style>
